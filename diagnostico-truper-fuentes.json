    "body": "document.addEventListener(\"DOMContentLoaded\", () => {\n    const items = document.getElementById(\"liveSearch\");\n    const parentItems = items.parentElement;\n    const btnSearch = document.getElementById('btnSearch');\n    const searchEngine = document.getElementById(\"word\");\n    const searchForm = searchEngine ? searchEngine.closest(\"form\") : null;\n    const BASE_URL = window.location.origin + \"/\" + window.location.pathname.split(\"/\")[1];\n\n    if (!searchEngine) return;\n\n    function getMatch(pn, word) {\n        if (!pn) return \"\";\n\n        let word1 = pn.toLowerCase();\n        let word2 = word.toLowerCase();\n\n        let start = word1.indexOf(word2);\n\n        if (start < 0) {\n        return pn;\n        }\n\n        let end = word.length + start;\n\n        let ellipses = start > 0 ? \"... \" : \"\";\n        let match = pn.substring(start, end);\n        let leftOver = pn.substring(end);\n\n        return ellipses + '<span class=\"highlight\">' + match + \"</span>\" + leftOver;\n    }\n\n    function getViewAllResultsUrl(word) {\n        if (searchForm) {\n        const formData = new FormData(searchForm);\n\n        if (searchEngine.name) {\n            formData.set(searchEngine.name, word);\n        }\n\n        const params = new URLSearchParams(formData);\n\n        return searchForm.action + \"?\" + params.toString();\n        }\n\n        const BASE_URL =\n        window.location.origin + \"/\" + window.location.pathname.split(\"/\")[1];\n        \n        return `${BASE_URL}/` + getCookie('reg') + `/products?word=${encodeURIComponent(word)}`;\n    }\n\n    function getCookie(nombre) {\n        const valor = `; ${document.cookie}`;\n        const partes = valor.split(`; ${nombre}=`);\n        \n        if (partes.length === 2) {\n            return partes.pop().split(';').shift();\n        }\n    }\n\n    searchEngine.addEventListener(\"keyup\", (e) => {\n        let word = e.target.value;\n\n        if (word.length >= 4) {\n            searching(word);\n        } else {\n        console.log(\"Es menor a 4 la longitud de la palabra\");\n        }\n    });\n\n    document.addEventListener(\"click\", (e) => {\n        if (!parentItems.contains(e.target)) {\n        parentItems.classList.add(\"hide\");\n        }\n    });\n\n    async function searching(word) {\n        try {\n            const BASE_URL =\n                window.location.origin + \"/\" + window.location.pathname.split(\"/\")[1];\n            const res = await fetch(`${BASE_URL}/searching/searchByWord?q=${word}`);\n\n            if (!res.ok) {\n                throw new Error(`Error ${res.status}`);\n            }\n\n            const data = await res.json();\n\n            console.log(data);\n\n            if (data.success) {\n                let output = \"\";\n                let notAvailable = \"\"; \n                \n                if (data.success && Array.isArray(data.results) && data.results.length > 0) {\n\n                    // Mostrar resultados...\n                    parentItems.classList.remove(\"hide\");\n\n                    output += \"<ul>\";\n                    \n                    data.results.slice(0, 5).forEach((item) => {\n                      output += \"<li>\";\n                      output +=\n                        '<a class=\\\"live-search hover\\\" href=\\\"' +\n                        item.url +\n                        '\\\" >';\n                      output +=\n                        '<div class=\"live-search-img\"><img src=\\\"' +\n                        item.urlImg +\n                        '\\\" height=\\\"32\\\" ' +\n                        notAvailable +\n                        \" ></div>\";\n                      output += '<div class=\"descrip\">';\n\n                      output += \"<div>\";\n                      output +=\n                        \"<p class='live-search-code'>\" +\n                        getMatch(item.codigo, word) +\n                        '<span class=\"live-search-separator\">|</span>' +\n                        getMatch(item.clave, word) +\n                        \"</p>\";\n                      output += \"<p class='live-search-item'>\" + getMatch(item.pn, word) + \"</p>\";\n                      output += \"</div></div>\";\n                      output += \"</a>\";\n                      output += \"</li>\";\n                    });\n                    \n                    if (data.results.length > 5) {\n                        output += '<li class=\"view-all-results\">';\n                        output += '<a href=\"' + getViewAllResultsUrl(word) + '\">';\n                        output += `<span>${window.VIEW_ALL_RESULTS}</span>`;\n                        output += `<img class=\"view-all-results-icon\" src=\"${window.VIEW_ALL_RESULTS_ICON}\">`;\n                        output += \"</a>\";\n                        output += \"</li>\";\n                    }\n\n                    output += \"</ul>\";\n                } else {\n                    parentItems.classList.remove(\"hide\");\n                    output = `\n                        <div class=\"no-results\">\n                            <p>${window.VIEW_NO_MATCH_FOUND} \"<strong>${word}</strong>\"</p>\n                        </div>\n                    `;\n                }\n                \n                items.replaceChildren();\n                items.insertAdjacentHTML(\"beforeend\", output);    \n            }\n        } catch (error) {\n            console.error(\"Error en búsqueda\", error);\n        }\n    }\n\n    btnSearch.addEventListener('click', () => {\n        \n        const word = searchEngine.value.trim();\n\n        if (word.length < 4) {\n            alert('Ingrese al menos 4 caracteres');\n            return;\n        }\n        \n        window.location.href =\n            BASE_URL + '/' + getCookie('reg') + '/products?word=' + encodeURIComponent(word);\n\n    });\n\n    searchEngine.addEventListener('keydown', (e) => {\n\n        if (e.key === 'Enter') {\n            e.preventDefault();\n\n            const word = searchEngine.value.trim();\n\n            if (word.length < 4) {\n                alert('Ingrese al menos 4 caracteres');\n                return;\n            }\n            \n            window.location.href =\n                BASE_URL + '/' + getCookie('reg') + '/products?word=' + encodeURIComponent(word);\n        }\n\n    });\n\n});\n"
  },
